<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE form-validation PUBLIC
          "-//Apache Software Foundation//DTD Commons Validator Rules Configuration 1.1.3//EN"
          "http://jakarta.apache.org/commons/dtds/validator_1_1_3.dtd">

<form-validation>
    <formset>
		<form name="NumeroContratoForm">
			<field property="numeroSIAC" depends="obrigatorio">
	    		<var><var-name>tipoAcao</var-name><var-value>alterar</var-value></var>
    			<arg position="0" key="Número do Contrato/Convênio" resource="false"/>
    		</field>
			<field property="unidadeLavratura" depends="obrigatorio">
	    		<var><var-name>tipoAcao</var-name><var-value>incluir,alterar,incluirManual</var-value></var>
    			<arg position="0" key="Unidade de Lavratura do Contrato" resource="false"/>
    		</field>
    		<field property="unidadeGestora" depends="obrigatorio">
	    		<var><var-name>tipoAcao</var-name><var-value>incluir,alterar,incluirManual</var-value></var>
    			<arg position="0" key="Unidade Gestora do Contrato" resource="false"/>
    		</field>
			<field property="unidadeLotacao" depends="obrigatorio">
	    		<var><var-name>tipoAcao</var-name><var-value>incluir,alterar,incluirManual</var-value></var>
    			<arg position="0" key="Unidade de Lotação do Solicitante" resource="false"/>
    		</field>
			<field property="nome" depends="obrigatorio">
	    		<var><var-name>tipoAcao</var-name><var-value>incluir,alterar,incluirManual</var-value></var>
    			<arg position="0" key="Nome do Solicitante" resource="false"/>
    		</field>
    		<field property="ano" depends="obrigatorio">
	    		<var><var-name>tipoAcao</var-name><var-value>incluirManual</var-value></var>
    			<arg position="0" key="Ano" resource="false"/>
    		</field>
    		<field property="numeroContratoConvenio" depends="obrigatorio">
	    		<var><var-name>tipoAcao</var-name><var-value>incluirManual</var-value></var>
    			<arg position="0" key="Número do Contrato/Convênio" resource="false"/>
    		</field>
    		<field property="situacao" depends="obrigatorio">
	    		<var><var-name>tipoAcao</var-name><var-value>alterar</var-value></var>
    			<arg position="0" key="Situação" resource="false"/>
    		</field>

			<!-- ************************************************************************ -->
			<!-- ******************************* CONSULTA ******************************* -->
			<!-- ************************************************************************ -->
			<field property="unidadeLavratura" depends="peloMenosUmObrigatorio">
            	<var><var-name>tipoAcao</var-name><var-value>consultar</var-value></var>
         		<var>
         			<var-name>listaCampos</var-name>
         			<var-value>unidadeGestora,
							   unidadeLotacao,
							   ano,
							   situacao,
							   numeroSIAC,
							   numeroSIASG
					</var-value>
         		</var>
            </field>
    	</form>
    </formset>
</form-validation>
