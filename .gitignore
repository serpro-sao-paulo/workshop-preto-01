# Reference materials cloned by scripts/setup.sh — never commit these.
# Note: legado-natural/ is bundled with the kit (real folder) and IS committed.
reference/
prototype
# Terraform state — NEVER commit state files (contains secrets)
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.backup
infra/**/*.tfplan
# Lock file IS committed (pinned provider versions)
!infra/**/.terraform.lock.hcl

# OS files
.DS_Store
**/.DS_Store

# Environment / secrets
.env
.env.local
.env.*.local

# Java
**/target/

# Node
**/node_modules/
**/.next/
**/.pnpm-store/

# Coverage
**/coverage/
**/.nyc_output/

# Logs
*.log
